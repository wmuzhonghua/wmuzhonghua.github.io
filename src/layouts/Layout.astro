---
import T from '../components/T.astro';
import ParticleBackground from '../components/ParticleBackground.astro';
import { profile } from '../data/profile';
import '../styles/global.css';
const { title, active = 'home' } = Astro.props;
const base = import.meta.env.BASE_URL;
const nav = [['home', '', 'Home', '首页'], ['research', 'research/', 'Research', '研究'], ['project', 'project/', 'Project', '项目'], ['cv', 'cv/', 'CV', '简历']];
const pageTitleZh = nav.find(([key]) => key === active)?.[3] || title;
const descriptionZh = `${profile.chineseName}（${profile.name}）的个人学术网站：${profile.institution}，关注医疗可及性、环境暴露与人群眼健康、生殖健康。`;
const descriptionEn = 'Academic portfolio of Zhonghua Lu at the School of Ophthalmology and Optometry, Wenzhou Medical University. Research on healthcare access, environmental exposures, eye health and reproductive health.';
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={descriptionZh} data-description-zh={descriptionZh} data-description-en={descriptionEn} />
  <meta name="theme-color" content="#faf9f5" />
  <title data-title-zh={`${pageTitleZh} · ${profile.name}`} data-title-en={`${title} · ${profile.name}`}>{pageTitleZh} · {profile.name}</title>
  <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  <script is:inline>
    try { const theme = localStorage.getItem('theme'); if (theme === 'dark' || theme === 'light') document.documentElement.dataset.theme = theme; } catch {}
    let preference = 'auto';
    try { const saved = localStorage.getItem('language'); if (saved === 'zh' || saved === 'en') preference = saved; } catch {}
    const browserLanguage = (navigator.languages && navigator.languages[0]) || navigator.language || 'en';
    document.documentElement.dataset.languagePreference = preference;
    document.documentElement.lang = (preference === 'auto' ? /^zh(?:-|$)/i.test(browserLanguage) : preference === 'zh') ? 'zh-CN' : 'en';
  </script>
</head>
<body>
  <a class="skip-link" href="#main"><T text="跳转到正文" en="Skip to content" /></a>
  <div class="ambient" aria-hidden="true"></div>
  <ParticleBackground />
  <header class="site-header">
    <nav class="nav-wrap" aria-label="主导航" data-aria-zh="主导航" data-aria-en="Main navigation">
      <a class="brand" href={base}><span class="brand-icon">✳</span><span>{profile.name}'s Portfolio</span></a>
      <div class="nav-actions">
        <div class="nav-links">{nav.map(([key, path, label, zh]) => <a href={`${base}${path}`} aria-current={active === key ? 'page' : undefined}><T text={zh} en={label} /></a>)}</div>
        <label class="theme-control"><span aria-hidden="true">◐</span><select id="theme" aria-label="选择配色主题" data-aria-zh="选择配色主题" data-aria-en="Color theme"><option value="system" data-i18n data-zh="跟随系统" data-en="System">跟随系统</option><option value="light" data-i18n data-zh="浅色" data-en="Light">浅色</option><option value="dark" data-i18n data-zh="深色" data-en="Dark">深色</option></select></label>
        <label class="language-control"><span aria-hidden="true">中 / EN</span><select id="language" aria-label="显示语言" data-aria-zh="显示语言" data-aria-en="Display language"><option value="auto" data-i18n data-zh="跟随浏览器" data-en="Browser">跟随浏览器</option><option value="zh">中文</option><option value="en">English</option></select></label>
      </div>
    </nav>
  </header>
  <main id="main"><slot /></main>
  <footer><div class="footer-inner"><p>© {new Date().getFullYear()} {profile.name}. <span class="footer-note"><T text="始于好奇。" en="Made with curiosity." /></span></p><div class="socials">{profile.socials.filter(s => s.url).map(s => <a href={s.url} target="_blank" rel="noopener noreferrer">{s.label} ↗</a>)}<a href={`${base}cv/#contact`}><T text="联系我 ↗" en="Contact ↗" /></a></div></div></footer>
  <script is:inline>
    (() => {
      const languageSelect = document.getElementById('language');
      function applyLanguage(preference) {
        const detected = (navigator.languages && navigator.languages[0]) || navigator.language || 'en';
        const locale = preference === 'auto' ? (/^zh(?:-|$)/i.test(detected) ? 'zh' : 'en') : preference;
        document.documentElement.lang = locale === 'zh' ? 'zh-CN' : 'en';
        document.documentElement.dataset.languagePreference = preference;
        document.querySelectorAll('[data-i18n]').forEach(el => { el.textContent = el.dataset[locale]; });
        document.querySelectorAll('[data-aria-zh]').forEach(el => { el.setAttribute('aria-label', el.getAttribute('data-aria-' + locale)); });
        document.querySelectorAll('[data-svg-title-zh]').forEach(el => { el.textContent = el.getAttribute('data-svg-title-' + locale); });
        const pageTitle = document.querySelector('title');
        pageTitle.textContent = pageTitle.getAttribute('data-title-' + locale);
        const description = document.querySelector('meta[name="description"]');
        description.content = description.getAttribute('data-description-' + locale);
        languageSelect.value = preference;
        document.dispatchEvent(new CustomEvent('languagechange', { detail: locale }));
      }
      applyLanguage(document.documentElement.dataset.languagePreference || 'auto');
      languageSelect.addEventListener('change', () => {
        const preference = languageSelect.value;
        try { if (preference === 'auto') localStorage.removeItem('language'); else localStorage.setItem('language', preference); } catch {}
        applyLanguage(preference);
      });
      window.addEventListener('languagechange', () => {
        if (document.documentElement.dataset.languagePreference === 'auto') applyLanguage('auto');
      });
    })();
  </script>
  <script>
    const select = document.querySelector<HTMLSelectElement>('#theme');
    if (select) {
      select.value = document.documentElement.dataset.theme || 'system';
      select.addEventListener('change', () => {
        const mode = select.value;
        if (mode === 'system') delete document.documentElement.dataset.theme;
        else document.documentElement.dataset.theme = mode;
        try { localStorage.setItem('theme', mode); } catch {}
      });
    }
  </script>
</body>
</html>
