---
import Layout from '../layouts/Layout.astro';
import { profile, grants } from '../data/profile';
import { publications } from '../data/publications';
const base = import.meta.env.BASE_URL;
---
<Layout title="CV" active="cv">
  <article class="cv-shell"><div class="cv-heading"><div><p class="eyebrow">BACKGROUND & EXPERIENCE</p><h1>Curriculum Vitae</h1></div><button class="button print-button" id="print-cv">打印 / 保存 PDF ↗</button></div>
  <div class="cv-identity"><h2>{profile.chineseName} <span>{profile.name}</span></h2><p>{profile.role}</p><a href={`mailto:${profile.email}`}>{profile.email}</a></div>
  <section class="cv-section"><h2>Education <span class="section-translation">教育经历</span></h2>{profile.education.map(item => <div class="cv-entry"><h3>{item.title}</h3><div class="entry-meta"><span>{item.institution}</span><span>{item.dates}</span></div>{item.detail && <p>{item.detail}</p>}</div>)}</section>
  <section class="cv-section"><h2>Research Experience <span class="section-translation">研究经历</span></h2>{profile.experience.map(item => <div class="cv-entry"><h3>{item.title}</h3><div class="entry-meta"><span>{item.institution}</span>{item.dates && <span>{item.dates}</span>}</div><p>{item.detail}</p></div>)}</section>
  <section class="cv-section"><h2>Selected Publications <span class="section-translation">代表性论文</span></h2><ol class="cv-publications">{publications.filter(p => p.featured).map(p => <li><h3>{p.title}</h3><p>{p.authors}</p><p><em>{p.venue}</em> · {p.year} · {p.role}</p></li>)}</ol><a class="text-link" href={`${base}research/`}>查看全部论文与投稿中的工作 →</a></section>
  <section class="cv-section"><h2>Research Grants <span class="section-translation">参与课题</span></h2><div class="grant-list">{grants.map(grant => <div class="grant-entry"><p class="grant-program">{grant.program} · {grant.number}</p><h3>{grant.title}</h3></div>)}</div></section>
  <section class="cv-section"><h2>Skills <span class="section-translation">研究与技术能力</span></h2><div class="skills-grid">{profile.skills.map(group => <div><h4>{group.title}</h4><ul>{group.items.map(item => <li>{item}</li>)}</ul></div>)}</div></section>
  <section class="cv-section"><h2>Awards & Honors <span class="section-translation">荣誉奖项</span></h2><div class="awards-list">{profile.awards.map(item => <div class="award-entry"><div class="entry-meta"><strong>{item.title}</strong><span>{item.dates}</span></div><p>{item.detail}</p></div>)}</div></section>
  <section class="cv-section" id="contact"><h2>Contact <span class="section-translation">联系我</span></h2><p>欢迎交流环境健康、多组学研究与代谢组学工具开发。</p><div class="contact-line"><a href={`mailto:${profile.email}`}>{profile.email}</a><button id="copy-email" data-email={profile.email} class="copy-button">复制邮箱</button><span id="copy-status" role="status"></span></div><a class="text-link" href={profile.socials[0].url} target="_blank" rel="noopener noreferrer">Google Scholar ↗</a></section>
  </article>
  <script>
    document.querySelector('#print-cv')?.addEventListener('click', () => window.print());
    document.querySelector<HTMLButtonElement>('#copy-email')?.addEventListener('click', async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      const status = document.querySelector('#copy-status');
      try { await navigator.clipboard.writeText(button.dataset.email || ''); if (status) status.textContent = '已复制'; }
      catch { if (status) status.textContent = '复制失败，请选中邮箱地址手动复制'; }
    });
  </script>
</Layout>
