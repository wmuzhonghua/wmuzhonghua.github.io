---
import T from '../components/T.astro';
import Layout from '../layouts/Layout.astro';
import EyeIllustration from '../components/EyeIllustration.astro';
import { profile } from '../data/profile';
const base = import.meta.env.BASE_URL;
---
<Layout title="Home" active="home">
  <div class="home-shell">
    <div class="hero">
      <div class="hero-content">
        <p class="hello"><T text="你好，我是" en="Hello, I'm" /></p>
        <h1>{profile.name}<span class="chinese-name">{profile.chineseName}</span></h1>
        <div class="home-affiliation"><p class="home-institution"><T text={profile.institution} /></p>{profile.affiliations.map(item => <p><T text={item} /></p>)}</div>
        <p class="home-research-theme"><T text={profile.role} /></p>
        <p class="bio"><T text={profile.bio} /></p>
        <div class="tags">{profile.interests.map(item => <span><T text={item} /></span>)}</div>
        <div class="hero-buttons"><a class="button primary" href={`${base}research/`}><T text="查看研究" en="View Research" /> <span>↗</span></a><a class="button" href={`${base}cv/`}><T text="查看简历" en="View CV" /> <span>→</span></a></div>
      </div>
      <div class="eye-area"><EyeIllustration /><p><T text="理解健康，拓展可及。" en="Understanding health. Broadening access." /></p></div>
    </div>
    <div class="home-bottom"><span class="status"><i></i> <T text="欢迎来到我的个人主页" en="Welcome to my personal website" /></span><span><T text="研究 · 创造 · 分享" en="Research. Build. Share." /></span></div>
  </div>
</Layout>

<style>
  .home-shell{padding-top:32px}
  .hero{padding-top:16px}
  .home-affiliation{margin-top:28px;color:var(--text);font-size:.8125rem;font-weight:700;line-height:1.9}
  .home-affiliation .home-institution{font-size:1rem;margin-bottom:5px}
  .home-research-theme{margin-top:24px;font-size:.9375rem;font-weight:500}
  .home-research-theme + .bio{margin-top:10px}
  .eye-area{min-width:0;display:flex;flex-direction:column;align-items:center;gap:22px}
  .eye-area>p{font-size:.625rem;color:var(--muted);letter-spacing:.5px;text-align:center}
  @media(max-width:800px){.eye-area{grid-row:1;width:min(100%,300px);margin:0 auto 16px;gap:8px}}
</style>
