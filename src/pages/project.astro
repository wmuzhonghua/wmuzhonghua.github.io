---
import T from '../components/T.astro';
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/profile';
---
<Layout title="Project" active="project">
  <div class="page-shell"><div class="page-heading"><p class="eyebrow"><T text="代谢组学工具与软件" en="METABOLOMICS TOOLS & SOFTWARE" /></p><h1><T text="项目展示" en="Project Gallery" /><span class="title-dot">.</span></h1><p><T text="从质谱数据到代谢物注释，让分析工作流更完整、更易用。" en="From mass spectrometry data to metabolite annotation: more complete, accessible analysis workflows." /></p></div>
  <div class="project-grid actual-projects">{projects.map((project,index) => <article class="project-card"><div class={`art ${project.kind}`} aria-hidden="true"><div class="art-orbit"></div><span class="art-index">0{index+1}</span></div><div class="project-copy"><p class="project-role"><T text={project.role} /></p><h2>{project.title}</h2><h3><T text={project.subtitle} /></h3><p><T text={project.description} /></p><ul class="project-details">{project.details.map(detail => <li><T text={detail} /></li>)}</ul>{project.note && <p class="project-note"><T text={project.note} /></p>}<div class="tags">{project.tags.map(tag => <span><T text={tag} /></span>)}</div>{project.url && <a class="project-link" href={project.url} target="_blank" rel="noopener noreferrer"><T text="查看项目 ↗" en="View project ↗" /></a>}</div></article>)}</div></div>
</Layout>
