---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/profile';
---
<Layout title="Project" active="project">
  <div class="page-shell"><div class="page-heading"><p class="eyebrow">METABOLOMICS TOOLS & SOFTWARE</p><h1>Project Gallery<span class="title-dot">.</span></h1><p>从质谱数据到代谢物注释，让分析工作流更完整、更易用。</p></div>
  <div class="project-grid actual-projects">{projects.map((project,index) => <article class="project-card"><div class={`art ${project.kind}`} aria-hidden="true"><div class="art-orbit"></div><span class="art-index">0{index+1}</span></div><div class="project-copy"><p class="project-role">{project.role}</p><h2>{project.title}</h2><h3>{project.subtitle}</h3><p>{project.description}</p><ul class="project-details">{project.details.map(detail => <li>{detail}</li>)}</ul>{project.note && <p class="project-note">{project.note}</p>}<div class="tags">{project.tags.map(tag => <span>{tag}</span>)}</div>{project.url && <a class="project-link" href={project.url} target="_blank" rel="noopener noreferrer">View project ↗</a>}</div></article>)}</div></div>
</Layout>
